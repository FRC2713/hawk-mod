{
  "schema": 1,
  "name": "hawk-mod",
  "image": "ghcr.io/frc2713/hawk-mod",
  "port": 3000,
  "health": "/health",
  "database": "hawk-mod.db",
  "data_dir": "/data",
  "required_env": [
    "SLACK_SIGNING_SECRET",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "SLACK_STATE_SECRET",
    "PUBLIC_URL",
    "TOKEN_ENCRYPTION_KEY"
  ],
  "optional_env": [
    "DATA_DIR",
    "PORT",
    "TZ",
    "LOG_MODE",
    "ALERT_CHANNEL_ID",
    "MANAGED_USERGROUPS",
    "REPORT_TIME",
    "SWEEP_CRON",
    "BACKFILL_CRON",
    "GOOGLE_SERVICE_ACCOUNT_KEY_BASE64",
    "LIFECYCLE_SHEET_ID"
  ],
  "migrations": "on-start",
  "rollback": "requires-schema-review"
}
