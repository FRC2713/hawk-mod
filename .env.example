# --- Slack app credentials (Basic Information -> App Credentials) ---
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Any long random string; signs the OAuth state param.
SLACK_STATE_SECRET=

# Public HTTPS base URL this app is reachable at. Slack posts events to
# $PUBLIC_URL/slack/events and redirects OAuth to $PUBLIC_URL/slack/oauth_redirect.
PUBLIC_URL=https://hawk-mod.example.org
PORT=3000

# Channel that receives findings. Private, screened adults only.
ALERT_CHANNEL_ID=C0000000000

# Where the SQLite database lives. One volume, nothing else is stateful.
DATA_DIR=./data

# 32 bytes, base64. Encrypts adult user tokens at rest.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# full     = store message text of monitored DMs (matches "keep everything")
# metadata = store who/when/how-many only, never message text
LOG_MODE=full

# Slack user groups that declare roles (Business+ only; user groups do not
# exist on the free plan). Leave unset to maintain the roster purely by CSV.
# Restrict "Create and edit user groups" to Owners/Admins before using these.
# Seeds only. Once hawk-mod is running these four are set from Slack with
# `/hawkmod config`, which stores them in the database and shows you where each
# value came from. A value set there wins over anything here.
STUDENT_USERGROUP=students
ADULT_USERGROUP=mentors

# Schedules (cron, in TZ). Defaults shown.
TZ=America/New_York
SWEEP_CRON=0 3 * * *
BACKFILL_CRON=15 * * * *

# When both morning reports (daily digest, quarterly reminder) go out. Seed
# only — `report-time` set from `/hawkmod config` or the web page wins.
REPORT_TIME=08:00

# Lifecycle sync (optional). Leave both unset to run without Google access.
# See docs/google-setup.md. The key file is a credential: never commit it.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
LIFECYCLE_SHEET_ID=
