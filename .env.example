# --- Slack app credentials (Basic Information -> App Credentials) ---
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Any long random string; signs the OAuth state param.
SLACK_STATE_SECRET=

# Public HTTPS base URL this app is reachable at. Slack posts events to
# $PUBLIC_URL/slack/events and redirects OAuth to $PUBLIC_URL/slack/oauth_redirect.
PUBLIC_URL=https://hawk-mod.example.org
PORT=3000

# Channel that receives findings. Private, screened adults only.
ALERT_CHANNEL_ID=C0000000000

# Where the SQLite database lives. One volume, nothing else is stateful.
DATA_DIR=./data

# 32 bytes, base64. Encrypts adult user tokens at rest.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# full     = store message text of monitored DMs (matches "keep everything")
# metadata = store who/when/how-many only, never message text
LOG_MODE=full

# Roles come from the lifecycle sheet. The Slack user groups copied from it
# (@students, @mentors, ...) are found by ID in code, not configured here.

# Schedules (cron, in TZ). Defaults shown.
TZ=America/New_York
SWEEP_CRON=0 3 * * *
BACKFILL_CRON=15 * * * *

# When both morning reports (daily digest, quarterly reminder) go out. Seed
# only — `report-time` set from `/hawkmod config` or the web page wins.
REPORT_TIME=08:00

# Lifecycle sync (optional). Leave these unset to run without Google access.
# See docs/google-setup.md. The key is a credential: never commit it. Give it
# one of two ways — base64 on one line (how production passes it), or a path
# to the JSON file (handy on a laptop). Base64 wins if both are set.
#   base64 -i key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
LIFECYCLE_SHEET_ID=
