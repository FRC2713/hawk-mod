# --- Slack app credentials (Basic Information -> App Credentials) ---
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Any long random string; signs the OAuth state param.
SLACK_STATE_SECRET=

# Public HTTPS base URL this app is reachable at. Slack posts events to
# $PUBLIC_URL/slack/events and redirects OAuth to $PUBLIC_URL/slack/oauth_redirect.
PUBLIC_URL=https://hawk-mod.example.org
PORT=3000

# Channel that receives findings. Private, screened adults only.
ALERT_CHANNEL_ID=C0000000000

# Where the SQLite database lives. One volume, nothing else is stateful.
DATA_DIR=./data

# 32 bytes, base64. Encrypts mentor user tokens at rest.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# full     = store message text of monitored DMs (matches "keep everything")
# metadata = store who/when/how-many only, never message text
LOG_MODE=full

# Schedules (cron, in TZ). Defaults shown.
TZ=America/New_York
SWEEP_CRON=0 3 * * *
BACKFILL_CRON=15 * * * *
DIGEST_CRON=0 8 * * *
QUARTERLY_CRON=0 9 1 1,4,7,10 *
